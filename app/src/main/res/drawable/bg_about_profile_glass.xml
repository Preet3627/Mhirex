<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E62A2050" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="@color/vibrantCyan" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#E61A132D"
                android:centerColor="#D9121628"
                android:endColor="#E6112530" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#6685F6FF" />
        </shape>
    </item>
</selector>

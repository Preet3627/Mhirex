<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#FFFF6B55" android:endColor="#FFB547FF" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#FFFF3D9A"
                android:centerColor="#FFC13CFF"
                android:endColor="#FF43E8FF" />
            <corners android:radius="27dp" />
            <stroke android:width="1dp" android:color="#99FFFFFF" />
        </shape>
    </item>
</selector>

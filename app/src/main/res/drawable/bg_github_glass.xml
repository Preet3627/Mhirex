<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E632244E" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/vibrantPink" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#D925193B"
                android:endColor="#D912202D" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#59FF65D7" />
        </shape>
    </item>
</selector>

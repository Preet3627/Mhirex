<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E6332357" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/vibrantCyan" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#D922193A"
                android:centerColor="#D9151930"
                android:endColor="#D9152631" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#5985F6FF" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="20dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:id="@+id/onboardingOrbOne"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-85dp"
                android:layout_marginEnd="-75dp"
                android:background="@drawable/bg_about_orb_pink"
                android:importantForAccessibility="no" />

            <View
                android:id="@+id/onboardingOrbTwo"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="-140dp"
                android:layout_marginBottom="120dp"
                android:background="@drawable/bg_about_orb_cyan"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_onboarding_glass"
                android:elevation="14dp"
                android:orientation="vertical"
                android:padding="22dp">

                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_about_logo_halo"
                    android:padding="10dp">

                    <!--
                        40dp, not match_parent. The previous logo was an opaque black square whose
                        mark occupied 57% of its width, so it read as roughly 39dp inside this 68dp
                        content box. brand_logo is a tightly cropped transparent mark, so
                        match_parent would render it at the full 68dp and grow the visible logo by
                        about 3x against the halo. Sized to the old mark's optical weight, the same
                        reasoning as the About card.
                    -->
                    <ImageView
                        android:id="@+id/ivOnboardingLogo"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/app_name"
                        android:scaleType="fitCenter"
                        android:src="@drawable/brand_logo" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_glass_pill"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="@string/str_onboarding_kicker"
                    android:textColor="@color/vibrantCyan"
                    android:textSize="9sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/str_onboarding_welcome_title"
                    android:textColor="@color/textColor"
                    android:textSize="23sp" />

                <TextView
                    android:id="@+id/tvOnboardingVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/str_version_1_0"
                    android:textColor="@color/vibrantPink"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.2"
                    android:text="@string/str_onboarding_welcome_body"
                    android:textColor="@color/iconSecondary"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.12"
                    android:text="@string/str_about_people_title"
                    android:textColor="@color/textColor"
                    android:textSize="12sp" />

                <!-- App idea and profile picture -->
                <LinearLayout
                    android:id="@+id/layoutIdeaInstagram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_onboarding_link_glass"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="86dp"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="top|start"
                            android:contentDescription="@string/str_about_idea_photo"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ig_idea"
                            app:shapeAppearanceOverlay="@style/ProfileImageShapeAppearance"
                            app:strokeColor="@color/vibrantPink"
                            app:strokeWidth="2dp" />

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_instagram_badge"
                            android:contentDescription="@null"
                            android:padding="3dp"
                            android:src="@drawable/ic_instagram_24" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.07"
                            android:text="@string/str_about_idea_label"
                            android:textColor="@color/vibrantPink"
                            android:textSize="9sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/str_about_idea_handle"
                            android:textColor="@color/textColor"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/str_onboarding_tap_to_visit"
                            android:textColor="@color/iconSecondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/str_about_open_instagram"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="@color/vibrantCyan" />
                </LinearLayout>

                <!-- Additional Instagram profile -->
                <LinearLayout
                    android:id="@+id/layoutMehulInstagram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_onboarding_link_glass"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="82dp"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="top|start"
                            android:contentDescription="@string/str_about_mehul_photo"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ig_mehul"
                            app:shapeAppearanceOverlay="@style/ProfileImageShapeAppearance"
                            app:strokeColor="@color/vibrantPurple"
                            app:strokeWidth="2dp" />

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_instagram_badge"
                            android:contentDescription="@null"
                            android:padding="3dp"
                            android:src="@drawable/ic_instagram_24" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.07"
                            android:text="@string/str_about_mehul_label"
                            android:textColor="@color/vibrantPurple"
                            android:textSize="9sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/str_about_mehul_handle"
                            android:textColor="@color/textColor"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/str_onboarding_tap_to_visit"
                            android:textColor="@color/iconSecondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/str_about_open_instagram"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="@color/vibrantCyan" />
                </LinearLayout>

                <!--
                    Lead developer. Matches the About tab's third card so the two surfaces cannot
                    disagree about who is credited. Compact popup metrics (48dp avatar, 9sp label)
                    and the onboarding glass background, same as the two cards above.
                -->
                <LinearLayout
                    android:id="@+id/layoutPreetInstagram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_onboarding_link_glass"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="82dp"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="top|start"
                            android:contentDescription="@string/str_about_preet_photo"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ig_preet"
                            app:shapeAppearanceOverlay="@style/ProfileImageShapeAppearance"
                            app:strokeColor="@color/vibrantOrange"
                            app:strokeWidth="2dp" />

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_instagram_badge"
                            android:contentDescription="@null"
                            android:padding="3dp"
                            android:src="@drawable/ic_instagram_24" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.07"
                            android:text="@string/str_about_preet_label"
                            android:textColor="@color/vibrantOrange"
                            android:textSize="9sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/str_about_preet_handle"
                            android:textColor="@color/textColor"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/str_onboarding_tap_to_visit"
                            android:textColor="@color/iconSecondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/str_about_open_instagram"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="@color/vibrantCyan" />
                </LinearLayout>

                <!--
                    Website link. The About tab has had a "Visit Website" action all along; this
                    brings the startup popup to parity, so the site is reachable from the first
                    screen a new user sees rather than only after finding the About tab.

                    The host is deliberately not printed. Branding.WEBSITE_URL stays the single
                    source of truth, so changing the domain cannot leave a stale string behind,
                    the same reasoning that keeps str_visit_website free of the URL.
                -->
                <LinearLayout
                    android:id="@+id/layoutOnboardingWebsite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_onboarding_link_glass"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="74dp"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_glass_pill"
                        android:contentDescription="@null"
                        android:padding="7dp"
                        android:src="@drawable/ic_public_24"
                        app:tint="@color/vibrantCyan" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/str_onboarding_website_title"
                            android:textColor="@color/textColor"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/str_onboarding_website_body"
                            android:textColor="@color/iconSecondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/str_visit_website"
                        android:src="@drawable/ic_arrow_up_right_24"
                        app:tint="@color/vibrantOrange" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnOnboardingGetStarted"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_onboarding_start"
                    android:clickable="true"
                    android:elevation="5dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/str_onboarding_start_creating"
                        android:textColor="@color/colorOnPrimary"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_up_right_24"
                        app:tint="@color/colorOnPrimary" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/str_mhirex_based_on"
                    android:textColor="@color/iconSecondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</FrameLayout>

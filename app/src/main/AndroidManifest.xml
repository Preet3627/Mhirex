<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <!-- For Android 13+ (API 33+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- For Android 12 and below -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        SEC-31: WRITE_EXTERNAL_STORAGE removed (was android:maxSdkVersion="28").

        Nothing writes to a public directory any more:
          * video/audio publishing goes through MediaPublisher (MediaStore + IS_PENDING) or a
            user-granted SAF tree URI;
          * the frame snapshot was the last holdout — its `API < Q` branch wrote via
            FileOutputStream into getExternalStoragePublicDirectory(DIRECTORY_PICTURES), and routing
            it through MediaPublisher removed that branch;
          * every remaining FileOutputStream (handwriting drawings, freeze frames, imported fonts)
            targets cacheDir or filesDir;
          * the residual getExternalStoragePublicDirectory calls only *navigate* for the read-only
            file browser and media picker, which READ_EXTERNAL_STORAGE / READ_MEDIA_* already covers.

        Verified by grep, not assumed — re-check this if a new public-directory write is added.
    -->
    
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
        Added for the Google Sign-In profile feature, and it is a meaningful change for this app:
        Mhirex previously had NO network permission at all, which is a genuine privacy property,
        the editor cannot phone home because it has no way to open a socket.

        It is now used for exactly two things:
          1. Credential Manager's Google account chooser, which is a system UI handoff.
          2. Downloading the profile photo from lh3.googleusercontent.com, cached locally.

        Video, audio and image processing are still entirely on-device via ffmpeg-kit; no project
        media is ever sent over the network. The About screen's privacy claim should be read as
        "your media never leaves the device", not "the app makes no network requests".

        Trade-off worth stating: adding INTERNET means the guarantee is now enforced by review and
        code inspection rather than by the absence of a permission. AuditTrail / Network Security
        Config are not used here.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Remove network permission injected by ExoPlayer dependency -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:name=".MhirexApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/logo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/logo"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="video/*" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!--
            SEC-33: was exported="true" with no permission guard.

            Every real caller is in-app and uses an explicit Intent
            (MainActivity.kt:554, ProjectImportActivity.kt:543), and this activity has no
            <intent-filter>, so no implicit launch from another app can reach it either.

            Exported was therefore pure attack surface, not capability: any app on the device
            could launch the editor against a content:// URI it holds no grant for. That is also
            what made P0-7 remotely triggerable — the editor hard-crashed in onCreate when the
            VIDEO_URI extra was absent, so a one-line malicious intent was a denial of service
            against Mhirex.

            If an external entry point is ever wanted (e.g. "Edit with Mhirex" from a file
            manager), add the <intent-filter> AND a signature-level permission in the same
            change. Do not restore exported="true" on its own.
        -->
        <activity
            android:name=".VideoEditingActivity"
            android:exported="false"
            android:theme="@style/Editor"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ProjectImportActivity"
            android:exported="false"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".ErrorDisplayActivity"
            android:exported="false"
            android:theme="@style/Editor" />

        <service
            android:name=".services.ExportService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
            
        <service
            android:name=".services.ProxyGenerationService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
    </application>

</manifest>
